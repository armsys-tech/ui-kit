{
  "schemaVersion": 2,
  "version": "2.0.0",
  "frameRule": "Public surfaces (website, docs, pricing, blog, data pages) share .aui-site + .aui-site-header + .aui-container + .aui-site-footer. Never give one page a different header or container width.",
  "patterns": {
    "adminPanel": {
      "example": "examples/dashboard.html",
      "recipe": "ai/recipes/admin-panel.md",
      "surface": "application",
      "shell": "aui-app > aui-sidebar + aui-app-main > aui-topbar + aui-app-content",
      "useFor": [
        "admin panel",
        "dashboard",
        "console",
        "back office",
        "CRM",
        "VPN/server management"
      ],
      "components": [
        "aui-page-header",
        "aui-metric",
        "aui-stats",
        "aui-card",
        "aui-table",
        "aui-toolbar",
        "aui-dropdown",
        "aui-modal",
        "aui-drawer",
        "aui-toast"
      ]
    },
    "monitoring": {
      "example": "examples/monitoring.html",
      "surface": "application",
      "useFor": [
        "live monitoring",
        "operations",
        "logs",
        "status"
      ],
      "components": [
        "aui-stat",
        "aui-uptime",
        "aui-log",
        "aui-conn",
        "aui-segmented"
      ]
    },
    "dataManagement": {
      "example": "examples/data-table.html",
      "surface": "application",
      "useFor": [
        "CRUD list",
        "records",
        "events table",
        "bulk actions"
      ],
      "components": [
        "aui-toolbar",
        "aui-table",
        "aui-bulkbar",
        "aui-pagination",
        "aui-drawer",
        "aui-empty"
      ]
    },
    "settings": {
      "example": "examples/settings.html",
      "surface": "application",
      "useFor": [
        "settings",
        "profile",
        "preferences",
        "API keys"
      ],
      "components": [
        "aui-settings",
        "aui-form-section",
        "aui-option-row",
        "aui-switch",
        "aui-save-bar",
        "aui-danger-zone"
      ]
    },
    "auth": {
      "examples": [
        "examples/login.html",
        "examples/register.html",
        "examples/forgot-password.html",
        "examples/two-factor.html"
      ],
      "recipe": "ai/recipes/auth.md",
      "surface": "application",
      "shell": "aui-auth > aui-auth-aside + aui-auth-main",
      "useFor": [
        "login",
        "sign up",
        "password reset",
        "2FA",
        "email verification",
        "invite"
      ]
    },
    "website": {
      "example": "examples/website.html",
      "recipe": "ai/recipes/marketing-site.md",
      "surface": "public",
      "shell": "aui-site + aui-site-header + sections + aui-site-footer",
      "useFor": [
        "landing page",
        "corporate site",
        "product page"
      ]
    },
    "documentation": {
      "example": "examples/documentation.html",
      "recipe": "ai/recipes/docs-site.md",
      "surface": "public",
      "shell": "aui-site + aui-site-header + aui-docs",
      "useFor": [
        "docs",
        "API reference",
        "guides",
        "changelog",
        "knowledge base"
      ]
    },
    "pricing": {
      "example": "examples/pricing.html",
      "surface": "public",
      "useFor": [
        "pricing",
        "plans",
        "comparison"
      ]
    },
    "publicData": {
      "example": "examples/leaderboard.html",
      "surface": "public",
      "useFor": [
        "leaderboard",
        "ranking",
        "directory",
        "catalog"
      ]
    },
    "embedded": {
      "example": "examples/embedded-panel.html",
      "surface": "island",
      "useFor": [
        "widget inside another app",
        "WordPress/Laravel partial",
        "browser extension popup"
      ],
      "shell": "<div class=\"aui aui--dense\"> + aui-mini"
    },
    "desktopApp": {
      "example": "examples/desktop.html",
      "recipe": "ai/recipes/electron-app.md",
      "surface": "desktop",
      "shell": "aui-desktop > aui-titlebar + aui-desktop-body > aui-app",
      "useFor": [
        "Electron",
        "Tauri",
        "WebView2",
        "desktop tool"
      ]
    },
    "componentReference": {
      "example": "index.html",
      "surface": "public",
      "useFor": [
        "design system docs",
        "showcase"
      ]
    }
  }
}